<UserControl x:Class="MutualPulse.Desktop.Views.Onboarding.InstagramConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Палитра приветственного экрана MutualPulse. -->
        <LinearGradientBrush x:Key="OnboardingBackgroundBrush" StartPoint="0,0.2" EndPoint="1,0.8">
            <GradientStop Offset="0" Color="#171038" />
            <GradientStop Offset="0.48" Color="#26144E" />
            <GradientStop Offset="1" Color="#401365" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,0.1">
            <GradientStop Offset="0" Color="#7545F9" />
            <GradientStop Offset="0.53" Color="#BA35E8" />
            <GradientStop Offset="1" Color="#FB239D" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TextPrimary" Color="#24154C" />
        <SolidColorBrush x:Key="TextSecondary" Color="#796C98" />

        <!-- Поле ввода: высота и типографика по образцу ProfileSetupView Mnemora. -->
        <Style x:Key="ProfileTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="12,0,46,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8CCED" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CaretBrush" Value="#874DE9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#874DE9" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsNameInvalid}" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#D0446A" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineBackButton" TargetType="Button">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F4EFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContinueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="176" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="9"
                                Background="{StaticResource PrimaryBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="#B9B0CF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource OnboardingBackgroundBrush}" ClipToBounds="True">
        <!-- Компактная разметка: при минимальном размере окна 1000×650
             карточка и кнопки полностью помещаются без прокрутки. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Декорации используют тот же холст 1600x900, что в Mnemora. -->
        <Viewbox Grid.RowSpan="3" Stretch="Fill" IsHitTestVisible="False">
            <Canvas Width="1600" Height="900">
                <Ellipse Width="690" Height="690" Canvas.Left="1120" Canvas.Top="-220">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#48AE61F3" />
                            <GradientStop Offset="1" Color="#00AE61F3" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="620" Height="620" Canvas.Left="-280" Canvas.Top="510">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#366C46E7" />
                            <GradientStop Offset="1" Color="#006C46E7" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Path Data="M0,210 L92,254 L165,224 L236,312 L314,280 M92,254 L48,350 L142,402 M236,312 L290,390 L374,420"
                      Stroke="#A569F1" StrokeThickness="1.2" Opacity="0.2" />
                <Path Data="M1260,118 L1342,164 L1420,130 L1495,214 L1600,178 M1342,164 L1310,252 L1390,302 M1495,214 L1450,322 L1554,380 L1600,350"
                      Stroke="#C46CFF" StrokeThickness="1.2" Opacity="0.22" />
                <Ellipse Width="8" Height="8" Canvas.Left="88" Canvas.Top="250" Fill="#A569F1" Opacity="0.5" />
                <Ellipse Width="8" Height="8" Canvas.Left="232" Canvas.Top="308" Fill="#A569F1" Opacity="0.5" />
                <Ellipse Width="8" Height="8" Canvas.Left="1338" Canvas.Top="160" Fill="#C46CFF" Opacity="0.5" />
                <Ellipse Width="8" Height="8" Canvas.Left="1491" Canvas.Top="210" Fill="#C46CFF" Opacity="0.5" />
            </Canvas>
        </Viewbox>

        <!-- Чёткий PNG-логотип для интерфейса; .ico остаётся иконкой окна/EXE. -->
        <Grid Grid.Row="0" Width="420" Height="74" Margin="28,6,28,0"
              HorizontalAlignment="Left">
            <ContentControl Template="{StaticResource MutualPulseTransparentLogoTemplate}"
                            Width="64" Height="64" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Focusable="False"
                            IsHitTestVisible="False" />
            <StackPanel Margin="76,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="28" FontWeight="SemiBold">
                    <Run Text="Mutual" Foreground="White" /><Run Text="Pulse" Foreground="#F251D2" />
                </TextBlock>
                <TextBlock Text="Поиск людей для взаимных подписок" Foreground="#E4DEFF" FontSize="13" />
            </StackPanel>
        </Grid>

        <!-- Верхний указатель из трёх шагов по образцу Mnemora. -->
        <Grid Grid.Row="1" MaxWidth="610" Height="64"
              HorizontalAlignment="Stretch" Margin="24,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="112" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                    Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Center">
                <TextBlock Text="1" Foreground="White" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Grid.Column="1" Height="3" CornerRadius="2"
                    Background="#75539C" VerticalAlignment="Center" Margin="4,0" />
            <Border Grid.Column="2" Width="40" Height="40" CornerRadius="20"
                    Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Center">
                <TextBlock Text="2" Foreground="White" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Grid.Column="3" Height="3" CornerRadius="2"
                    Background="#75539C" VerticalAlignment="Center" Margin="4,0" />
            <Border Grid.Column="4" Width="40" Height="40" CornerRadius="20"
                    Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Center">
                <TextBlock Text="3" Foreground="White" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="О себе" Foreground="#C9B9E5"
                       FontSize="14" TextAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Chrome" Foreground="#C9B9E5"
                       FontSize="14" TextAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="4" Text="Instagram" Foreground="White"
                       FontWeight="SemiBold" FontSize="14" TextAlignment="Center" />
        </Grid>

        <!-- Карточка и номер шага оформлены по образцу первого этапа. -->
        <Grid Grid.Row="2" Margin="40,0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" MaxWidth="720" Background="White" CornerRadius="22"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#10052B" BlurRadius="28" ShadowDepth="8" Opacity="0.3" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="40,20,40,20">
                        <Grid Width="72" Height="72" HorizontalAlignment="Center">
                            <Ellipse Fill="#F5EEFF" Stroke="#A74BF0" StrokeThickness="2.5" />
                            <!-- Иконка подключения аккаунта. -->
                            <Viewbox Width="42" Height="42" Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="48" Height="48">
                                    <Ellipse Canvas.Left="17" Canvas.Top="6" Width="14" Height="14"
                                             Stroke="#8241D8" StrokeThickness="2.8" Fill="Transparent" />
                                    <Path Data="M 7,39 C 7,28 14,24 24,24 C 34,24 41,28 41,39"
                                          Stroke="#8241D8" StrokeThickness="2.8" Fill="Transparent"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Ellipse Canvas.Left="32" Canvas.Top="30" Width="14" Height="14"
                                             Fill="#F5EEFF" Stroke="#8241D8" StrokeThickness="2" />
                                    <Path Data="M 35,37 L 38,40 L 43,34" Stroke="#20A96A"
                                          StrokeThickness="2.5" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <TextBlock Text="Подключение Instagram" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" TextAlignment="Center"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="Войдите в Instagram в отдельном Chrome-профиле MutualPulse. Укажите имя аккаунта и проверьте сессию. Пароль приложение не запрашивает и не сохраняет."
                                   FontSize="15" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondary}" TextAlignment="Center"
                                   LineHeight="22" Margin="0,7,0,14" />
                        <TextBlock Text="Имя аккаунта Instagram"
                                   Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"
                                   FontSize="14" Margin="0,0,0,7" />
                        <!-- Проверка формата имени — как на первом шаге: рамка, подсказка,
                             галочка или ошибка. Это ещё НЕ проверка Instagram-сессии. -->
                        <Grid>
                            <TextBox x:Name="AccountNameInput"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProfileTextBox}" MaxLength="30" />
                            <TextBlock Text="Например, my_account" Margin="12,0,0,0"
                                       FontSize="18" Foreground="#ADA0C7" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsNameEmpty}" Value="True" />
                                                    <Condition Binding="{Binding ElementName=AccountNameInput, Path=IsKeyboardFocused}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="✓" FontSize="22" FontWeight="Bold"
                                       Foreground="#20A96A" Margin="0,0,18,0"
                                       IsHitTestVisible="False" HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       ToolTip="Формат имени корректен. Сессия ещё не проверена."
                                       Visibility="{Binding IsNameValid, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="!" FontSize="22" FontWeight="Bold"
                                       Foreground="#D0446A" Margin="0,0,18,0"
                                       IsHitTestVisible="False" HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsNameInvalid, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <TextBlock Text="{Binding ValidationMessage}" FontSize="12" Foreground="#D0446A"
                                   TextWrapping="Wrap" Margin="3,5,0,0"
                                   Visibility="{Binding IsNameInvalid, Converter={StaticResource BoolToVisibility}}" />
                        <!-- Результат проверки слева, сброс подтверждённой сессии справа. -->
                        <Grid Margin="3,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="StatusLabel" Visibility="Collapsed"
                                       Foreground="{StaticResource TextSecondary}" FontSize="13"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="ResetButton" Content="Сбросить сессию"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Foreground="#A74478" FontSize="13" Padding="5"
                                    Margin="12,0,0,0" BorderThickness="0"
                                    Background="Transparent" Click="ResetButton_OnClick"
                                    Visibility="{Binding ShowReset, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <ProgressBar x:Name="CheckProgress" IsIndeterminate="True" Height="4"
                                     Foreground="#9352EA" Margin="0,10,0,0"
                                     Visibility="Collapsed" />
                    </StackPanel>
                    <Border Grid.Row="1" BorderBrush="#E6DFF3" BorderThickness="0,1,0,0"
                            Padding="40,16,40,17">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BackButton" Click="BackButton_OnClick"
                                        Style="{StaticResource OutlineBackButton}"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="←" FontSize="19" Margin="0,0,9,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Назад" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <!-- Одно основное действие, соответствующее текущему этапу подключения. -->
                                <Grid Grid.Column="2" HorizontalAlignment="Right">
                                    <Button x:Name="OpenButton" Content="Открыть Instagram"
                                            Click="OpenButton_OnClick" Style="{StaticResource ContinueButtonStyle}"
                                            IsEnabled="False"
                                            Visibility="{Binding ShowOpen, Converter={StaticResource BoolToVisibility}}" />
                                    <Button x:Name="VerifyButton" Content="Проверить сессию"
                                            Click="VerifyButton_OnClick" Style="{StaticResource ContinueButtonStyle}"
                                            IsEnabled="False"
                                            Visibility="{Binding ShowVerify, Converter={StaticResource BoolToVisibility}}" />
                                    <Button x:Name="ContinueButton" Content="Далее →"
                                            Click="ContinueButton_OnClick" Style="{StaticResource ContinueButtonStyle}"
                                            IsEnabled="False"
                                            Visibility="{Binding ShowContinue, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Grid.Row="1" Text="Шаг 3 из 3" Foreground="#F6F0FF"
                       HorizontalAlignment="Center" FontSize="15" Margin="0,12,0,0" />
        </Grid>
    </Grid>
</UserControl>

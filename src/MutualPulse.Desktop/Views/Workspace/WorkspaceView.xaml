<UserControl x:Class="MutualPulse.Desktop.Views.Workspace.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="WorkspaceView_OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisible" />
        <!-- Кисти и навигация перенесены из рабочего окна ChatPulse. -->
        <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#171038" Offset="0" />
            <GradientStop Color="#26144E" Offset="0.6" />
            <GradientStop Color="#401365" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7545F9" Offset="0" />
            <GradientStop Color="#BA35E8" Offset="0.54" />
            <GradientStop Color="#FB239D" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E9E1F5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style x:Key="SidebarToggleButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,30,-16,0" />
            <Setter Property="Background" Value="#493074" />
            <Setter Property="BorderBrush" Value="#8764BB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Path x:Name="Chevron" Data="M 13,4 L 7,10 L 13,16"
                                  Width="20" Height="20" Stretch="None"
                                  Stroke="#FFFFFF" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Content" Value="›">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="-1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#65409A" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#C096F8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#321D57" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                CornerRadius="10" BorderBrush="Transparent"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#7951B7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F7F6FC">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Боковая навигация воспроизводит компоновку ChatPulse. -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="14,24,14,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="7,0,0,35">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Template="{StaticResource MutualPulseTransparentLogoTemplate}"
                                        Focusable="False" IsHitTestVisible="False"
                                        VerticalAlignment="Center">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Width" Value="46" />
                                    <Setter Property="Height" Value="46" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                            <Setter Property="Width" Value="40" />
                                            <Setter Property="Height" Value="40" />
                                            <Setter Property="Margin" Value="-7,0,0,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                        <TextBlock Text="MutualPulse" FontSize="20" FontWeight="Bold" Foreground="White"
                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisible}}" />
                    </StackPanel>
                </Grid>

                <Button x:Name="HomeButton" Grid.Row="1" Click="HomeButton_OnClick"
                        Style="{StaticResource NavigationButton}" ToolTip="Главная">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⌂" FontSize="25" Width="34" TextAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Главная" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisible}}" />
                    </StackPanel>
                </Button>

                <Button x:Name="SearchButton" Grid.Row="2" Click="SearchButton_OnClick"
                        Style="{StaticResource NavigationButton}" ToolTip="Поиск" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="23" Height="23" Margin="5,0,6,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Ellipse Width="13" Height="13" Canvas.Left="3" Canvas.Top="3"
                                         Stroke="White" StrokeThickness="2.2" />
                                <Line X1="14.2" Y1="14.2" X2="21" Y2="21" Stroke="White"
                                      StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Поиск" VerticalAlignment="Center"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisible}}" />
                    </StackPanel>
                </Button>

                <Border Grid.Row="4" Height="1" Background="#554070" Margin="14,10,14,12" />

                <Button x:Name="SettingsButton" Grid.Row="5" Click="SettingsButton_OnClick"
                        Style="{StaticResource NavigationButton}" ToolTip="Настройки" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="21" Width="34" TextAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Настройки" VerticalAlignment="Center"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisible}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Button x:Name="CollapseButton" Grid.Column="0" Panel.ZIndex="10"
                Content="‹" Style="{StaticResource SidebarToggleButton}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                ToolTip="Свернуть или раскрыть панель"
                Click="ToggleSidebarButton_OnClick" />

        <Grid Grid.Column="1" Margin="34,22,34,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Заголовок всегда остаётся на месте при прокрутке страницы. -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PageTitle" Text="Главная" FontSize="32" FontWeight="Bold"
                           Foreground="#24154C" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,18,0" />
                <Border Grid.Column="1" Background="White" CornerRadius="11"
                        BorderBrush="#E8DDF3" BorderThickness="1" Padding="15,10">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="#BA35E8" VerticalAlignment="Center"
                                 Margin="0,0,9,0" />
                        <TextBlock x:Name="HeaderAccountLabel" Text="Instagram не подключён"
                                   Foreground="#65547D" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Главная: те же карточки обзора, что в ChatPulse, без фиктивных данных. -->
            <ScrollViewer x:Name="HomePage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,15">
                    <TextBlock Text="Обзор найденных аккаунтов и работы с потенциальными участницами"
                               FontSize="14" Foreground="#837397" Margin="0,0,0,24"
                               TextWrapping="Wrap" />

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,10,0" MinHeight="128">
                            <StackPanel>
                                <TextBlock Text="Найдено аккаунтов" Foreground="#74658B" FontSize="13" />
                                <TextBlock Text="—" Foreground="#24154C" FontWeight="Bold" FontSize="30"
                                           Margin="0,8,0,2" />
                                <TextBlock Text="После первого поиска" Foreground="#9385A8" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="5,0" MinHeight="128">
                            <StackPanel>
                                <TextBlock Text="Новые контакты" Foreground="#74658B" FontSize="13" />
                                <TextBlock Text="—" Foreground="#24154C" FontWeight="Bold" FontSize="30"
                                           Margin="0,8,0,2" />
                                <TextBlock Text="Ещё не обработаны" Foreground="#9385A8" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PanelCard}" Margin="10,0,0,0" MinHeight="128">
                            <StackPanel>
                                <TextBlock Text="Вступили в группу" Foreground="#74658B" FontSize="13" />
                                <TextBlock Text="—" Foreground="#24154C" FontWeight="Bold" FontSize="30"
                                           Margin="0,8,0,2" />
                                <TextBlock Text="Статистика появится позже" Foreground="#9385A8" FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Прогресс обработки" Foreground="#24154C"
                                       FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Появится после реализации сбора аккаунтов и отметок о взаимодействиях."
                                       Foreground="#81718F" TextWrapping="Wrap" FontSize="13"
                                       Margin="0,8,0,14" />
                            <Border Height="9" Background="#F0E9FA" CornerRadius="5" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Последние источники" Foreground="#24154C"
                                       FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="Публикации Instagram появятся здесь после первых запусков поиска."
                                       Foreground="#81718F" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Поиск — самостоятельная страница; сбор данных пока не реализован. -->
            <ScrollViewer x:Name="SearchPage" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Margin="0,0,10,15">
                    <TextBlock Text="Поиск потенциальных участниц по публикациям Instagram"
                               FontSize="14" Foreground="#837397" Margin="0,0,0,24"
                               TextWrapping="Wrap" />
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Поиск участников" Foreground="#24154C"
                                       FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="Здесь будет запуск сбора лайков и комментариев по ссылке на выбранную публикацию Instagram."
                                       Foreground="#81718F" FontSize="14" TextWrapping="Wrap" />
                            <Border Background="#F5EFFF" CornerRadius="10" Margin="0,18,0,0" Padding="15,13">
                                <TextBlock Text="Модуль поиска пока не подключён. Эта страница подготовлена для следующего этапа разработки."
                                           Foreground="#6D4A95" FontSize="13" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="История поиска" Foreground="#24154C"
                                       FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="Когда появится поиск, здесь будут сохранённые публикации и результаты запусков."
                                       Foreground="#81718F" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Настройки остаются, как в ChatPulse; Telegram не переносим. -->
            <ScrollViewer x:Name="SettingsPage" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Margin="0,0,10,15">
                    <TextBlock Text="Параметры подключения MutualPulse"
                               FontSize="14" Foreground="#837397" Margin="0,0,0,24" />
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Instagram" Foreground="#24154C" FontSize="18"
                                       FontWeight="SemiBold" Margin="0,0,0,10" />
                            <TextBlock x:Name="AccountLabel" Text="Instagram не подключён"
                                       Foreground="#74658B" FontSize="14" Margin="0,0,0,18" />
                            <Button Content="Переподключить Instagram"
                                    Style="{StaticResource MutualPulseOnboardingOutlinedButton}"
                                    HorizontalAlignment="Left"
                                    Click="ReconnectButton_OnClick" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="MutualPulse.Desktop.Views.Workspace.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Segoe UI">
    <Grid Background="#F5F0FF">
        <Border Width="710" Padding="40" CornerRadius="22" HorizontalAlignment="Center"
                VerticalAlignment="Center" Background="White">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <ContentControl Template="{StaticResource MutualPulseTransparentLogoTemplate}"
                                    Width="92" Height="92" Margin="0,0,16,0"
                                    Focusable="False" IsHitTestVisible="False" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="38" FontWeight="SemiBold" Foreground="#512394" Text="MutualPulse"/>
                        <TextBlock FontSize="14" Foreground="#806D9D" Text="Поиск людей для взаимных подписок"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="Первоначальная настройка завершена" FontSize="25" FontWeight="SemiBold"
                           Foreground="#24154C" TextAlignment="Center" Margin="0,0,0,14"/>
                <TextBlock x:Name="AccountLabel" Foreground="#7545C8" TextAlignment="Center" FontSize="16"
                           Margin="0,0,0,20"/>
                <TextBlock Text="На этом этапе реализован только онбординг. Парсер публикаций и CRM будут добавлены позже."
                           Foreground="#786C98" FontSize="15" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,0,0,26"/>
                <Button Style="{StaticResource MutualPulseOnboardingOutlinedButton}"
                        Content="Переподключить Instagram" HorizontalAlignment="Center"
                        Click="ReconnectButton_OnClick"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
